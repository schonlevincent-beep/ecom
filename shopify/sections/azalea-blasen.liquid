{% comment %}
  Azaléa – Sales Page für Blasen (Creative 90), "raw" Look
  In der Produktvorlage "product.blasen" zweimal einfügen:
  1x über dem Produktbereich (Abschnitt: "Oben"), 1x direkt darunter (Abschnitt: "Unten").
  Preis, 2+1-Angebot, Warenkorb und Express-Checkout kommen aus dem normalen Produktbereich.
  Bezahl-Icons + Häkchen liegen separat im Snippet "azalea-trust-badges" (als Block im Produktbereich).
{% endcomment %}

{%- liquid
  assign teil = section.settings.teil
  assign pflaster = section.settings.pflaster_pro_rolle | default: 90
  assign stueck_cent = section.settings.stueck_cent | default: 32
  assign apo_cent = section.settings.apotheke_cent | default: 184
  assign faktor = apo_cent | divided_by: stueck_cent
-%}

<style>
  .azb { color: #111; font-family: Arial, Helvetica, sans-serif; font-size: 17px; line-height: 1.5; }
  .azb * { box-sizing: border-box; }
  .azb-wrap { max-width: 720px; margin: 0 auto; padding: 0 16px; }
  .azb h1, .azb h2 { font-family: Arial, Helvetica, sans-serif; font-weight: 900; color: #111; margin: 0 0 12px; letter-spacing: -.01em; }
  .azb h1 { font-size: clamp(30px, 7vw, 46px); line-height: 1.05; text-transform: uppercase; }
  .azb h2 { font-size: clamp(24px, 5.2vw, 32px); line-height: 1.12; }
  .azb p { margin: 0 0 12px; }
  .azb mark { background: #ffe14a; color: #111; padding: 0 4px; }
  .azb-sec { padding: 36px 0; }
  .azb-sec + .azb-sec { border-top: 3px solid #111; }

  .azb-top { background: #d62d20; color: #fff; text-align: center; font-weight: 700; font-size: 15px; padding: 9px 12px; text-transform: uppercase; letter-spacing: .02em; }
  .azb-hero { padding-top: 22px; padding-bottom: 6px; }
  .azb-kicker { display: inline-block; background: #111; color: #fff; font-weight: 700; font-size: 13px; padding: 4px 8px; text-transform: uppercase; margin-bottom: 12px; }
  .azb-sub { font-size: 18px; }

  .azb-vs { display: grid; grid-template-columns: 1fr 1fr; border: 3px solid #111; margin-top: 16px; }
  .azb-vs > div { padding: 14px; text-align: center; }
  .azb-vs > div + div { border-left: 3px solid #111; background: #fffbe0; }
  .azb-vs small { display: block; font-size: 13px; font-weight: 700; text-transform: uppercase; }
  .azb-big { font-size: clamp(30px, 8vw, 44px); font-weight: 900; line-height: 1.1; }
  .azb-strike { color: #d62d20; text-decoration: line-through; text-decoration-thickness: 3px; }
  .azb-green { color: #12823b; }


  .azb-table { width: 100%; border-collapse: collapse; border: 3px solid #111; font-size: 16px; }
  .azb-table th, .azb-table td { border: 1px solid #111; padding: 10px 8px; text-align: center; }
  .azb-table th { background: #111; color: #fff; font-size: 14px; text-transform: uppercase; }
  .azb-table td:first-child { text-align: left; font-weight: 700; }
  .azb-table .us { background: #fffbe0; font-weight: 900; }
  .azb-y { color: #12823b; font-weight: 900; font-size: 20px; }
  .azb-n { color: #d62d20; font-weight: 900; font-size: 20px; }
  .azb-small { font-size: 13px; color: #555; }

  .azb-step { display: grid; grid-template-columns: 54px 1fr; gap: 14px; align-items: start; margin-bottom: 18px; }
  .azb-num { width: 54px; height: 54px; background: #ffe14a; border: 3px solid #111; font-weight: 900; font-size: 28px; display: grid; place-items: center; }
  .azb-step h3 { margin: 4px 0 4px; font-size: 20px; font-weight: 900; }
  .azb-step img, .azb-ph { width: 100%; margin-top: 8px; border: 2px solid #111; display: block; }
  .azb-ph { aspect-ratio: 16/10; background: #eee; display: grid; text-align: center; place-items: center; color: #888; font-size: 14px; }

  .azb-life { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .azb-life figure { margin: 0; border: 2px solid #111; background: #fff; }
  .azb-life img, .azb-life .azb-ph { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; border: 0; margin: 0; }
  .azb-life figcaption { padding: 8px 10px; font-size: 15px; border-top: 2px solid #111; }
  .azb-life figcaption b { display: block; }

  .azb-faq h3 { font-size: 18px; font-weight: 900; margin: 18px 0 4px; }
  .azb-faq h3::before { content: "Frage: "; color: #d62d20; }

  .azb-guar { border: 3px dashed #111; padding: 18px; display: grid; grid-template-columns: 84px 1fr; gap: 16px; align-items: center; background: #fffbe0; }
  .azb-seal { width: 84px; height: 84px; border-radius: 50%; border: 3px solid #111; display: grid; place-items: center; text-align: center; font-weight: 900; line-height: 1; font-size: 13px; background: #ffe14a; }
  .azb-seal span { display: block; font-size: 30px; }
  .azb-cta { display: block; text-align: center; margin-top: 22px; background: #12823b; color: #fff !important; text-decoration: none; padding: 18px 16px; font-weight: 900; font-size: 20px; text-transform: uppercase; border: 3px solid #111; box-shadow: 4px 4px 0 #111; }
  .azb-cta small { display: block; font-size: 13px; font-weight: 700; text-transform: none; }

  .azb-sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; background: #ffe14a; border-top: 3px solid #111; padding: 8px 12px calc(8px + env(safe-area-inset-bottom, 0px)); display: none; align-items: center; justify-content: space-between; gap: 10px; font-family: Arial, Helvetica, sans-serif; }
  .azb-sticky span { font-size: 14px; font-weight: 700; color: #111; }
  .azb-sticky a { background: #12823b; color: #fff !important; text-decoration: none; padding: 11px 16px; font-weight: 900; border: 2px solid #111; white-space: nowrap; }
  @media (max-width: 749px) { .azb-sticky { display: flex; } .azb-table { font-size: 14px; } }
</style>

<div class="azb">
{%- if teil == 'oben' -%}
  {%- if section.settings.top_text != blank -%}
    <div class="azb-top">{{ section.settings.top_text }}</div>
  {%- endif -%}
  <div class="azb-wrap azb-hero">
    <span class="azb-kicker">{{ section.settings.kicker }}</span>
    <h1>{{ section.settings.headline }}</h1>
    <p class="azb-sub">{{ section.settings.subline }}</p>
    <div class="azb-vs">
      <div>
        <small>{{ section.settings.apotheke_label }}</small>
        <div class="azb-big azb-strike">{{ apo_cent | money }}</div>
        <small>pro Pflaster</small>
      </div>
      <div>
        <small>Azaléa Rolle</small>
        <div class="azb-big azb-green">{{ stueck_cent | money }}</div>
        <small>pro Pflaster*</small>
      </div>
    </div>
    <p class="azb-small" style="margin-top:6px">* ca. {{ pflaster }} Pflaster pro Rolle, je nach Größe.</p>
  </div>

{%- else -%}

  <section class="azb-sec">
    <div class="azb-wrap">
      <h2>Warum zahlst du <mark>{{ faktor }}× mehr</mark> für dasselbe Pflaster?</h2>
      <p>Blasenpflaster aus der Apotheke sind Hydrokolloid: eine Schicht, die Wundflüssigkeit aufnimmt und die Blase feucht und geschützt hält, plus eine dünne wasserfeste Folie.</p>
      <p><b>Unsere Rolle ist genau so aufgebaut.</b> Nur bekommst du sie am Stück und schneidest dir jedes Pflaster selbst zu. Kein Markenname, keine Einzelverpackung, kein Aufpreis.</p>
      <div style="overflow-x:auto">
        <table class="azb-table">
          <thead><tr><th></th><th>Azaléa Rolle</th><th>Einzelpflaster</th></tr></thead>
          <tbody>
            <tr><td>Preis pro Pflaster</td><td class="us">{{ stueck_cent | money }}</td><td>{{ apo_cent | money }}</td></tr>
            <tr><td>Hydrokolloid</td><td class="us azb-y">✔</td><td class="azb-y">✔</td></tr>
            <tr><td>Größe selbst wählen</td><td class="us azb-y">✔</td><td class="azb-n">✘</td></tr>
            <tr><td>Wasserfest (Dusche)</td><td class="us azb-y">✔</td><td class="azb-y">✔</td></tr>
            <tr><td>Zeh bis Ferse aus einer Packung</td><td class="us azb-y">✔</td><td class="azb-n">✘</td></tr>
          </tbody>
        </table>
      </div>
      <p class="azb-small" style="margin-top:8px">Vergleichspreis: typischer Stückpreis von Marken-Blasenpflastern im Handel, Stand {{ 'now' | date: '%m/%Y' }}.</p>
    </div>
  </section>

  <section class="azb-sec">
    <div class="azb-wrap">
      <h2>So einfach geht's</h2>
      {%- for i in (1..3) -%}
        {%- liquid
          case i
            when 1
              assign t = 'Zuschneiden'
              assign d = 'Stück passend zur Blase abschneiden, mit etwas Rand. Ecken rund schneiden, dann hält es länger.'
              assign img = section.settings.bild_1
            when 2
              assign t = 'Aufkleben'
              assign d = 'Haut trocken machen, Folie ab, glatt andrücken. 10 Sekunden mit der Hand anwärmen.'
              assign img = section.settings.bild_2
            when 3
              assign t = 'Drauflassen'
              assign d = 'Bleibt drauf, bis es von selbst abgeht. Wird es weißlich, arbeitet das Hydrokolloid.'
              assign img = section.settings.bild_3
          endcase
        -%}
        <div class="azb-step">
          <div class="azb-num">{{ i }}</div>
          <div>
            <h3>{{ t }}</h3>
            <p>{{ d }}</p>
            {%- if img != blank -%}{{ img | image_url: width: 900 | image_tag: loading: 'lazy', alt: t }}{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </section>

  <section class="azb-sec">
    <div class="azb-wrap">
      <h2>Im Alltag</h2>
      <p>Überall, wo Schuhe drücken.</p>
      <div class="azb-life">
        {%- for block in section.blocks -%}
          <figure {{ block.shopify_attributes }}>
            {%- if block.settings.bild != blank -%}
              {{ block.settings.bild | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.titel }}
            {%- else -%}
              <div class="azb-ph">Foto: {{ block.settings.titel }}</div>
            {%- endif -%}
            <figcaption><b>{{ block.settings.titel }}</b>{{ block.settings.text }}</figcaption>
          </figure>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="azb-sec">
    <div class="azb-wrap azb-faq">
      <h2>Häufige Fragen</h2>
      <h3>Wie viele Pflaster bekomme ich aus einer Rolle?</h3>
      <p>Rund {{ pflaster }}, je nachdem wie groß du schneidest.</p>
      <h3>Wie lange bleibt ein Pflaster drauf?</h3>
      <p>Bis es von selbst abgeht, meist ein paar Tage. Nicht vorher abreißen.</p>
      <h3>Kann ich damit duschen?</h3>
      <p>Ja, die Folie ist wasserfest. Danach trocken tupfen.</p>
      <h3>Ist das wie ein Markenpflaster?</h3>
      <p>Gleiches Prinzip: Hydrokolloid unter wasserfester Folie. Nur als Rolle statt einzeln verpackt.</p>
      <h3>Wann lieber nicht?</h3>
      <p>Nicht auf infizierte, stark blutende oder tiefe Wunden. Bei Diabetes oder Durchblutungsstörungen an den Füßen vorher ärztlich abklären.</p>
    </div>
  </section>

  <section class="azb-sec">
    <div class="azb-wrap">
      <div class="azb-guar">
        <div class="azb-seal"><span>30</span>TAGE</div>
        <p style="margin:0"><b>Geld-zurück-Garantie.</b> Teste die Rolle 30 Tage. Wenn sie dich nicht überzeugt, schreib uns und du bekommst dein Geld zurück.</p>
      </div>
      <a class="azb-cta" href="#MainContent" data-azb-cta>{{ section.settings.cta }}<small>{{ section.settings.cta_sub }}</small></a>
    </div>
  </section>

  <div class="azb-sticky">
    <span>{{ stueck_cent | money }} pro Pflaster</span>
    <a href="#MainContent" data-azb-cta>{{ section.settings.cta_kurz }}</a>
  </div>
  <script>
    // Kauf-Knöpfe springen zum Warenkorb-Button des normalen Produktbereichs
    document.querySelectorAll('[data-azb-cta]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        var t = document.querySelector('form[action*="/cart/add"]') || document.getElementById('MainContent');
        if (t) { e.preventDefault(); t.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
      });
    });
  </script>
{%- endif -%}
</div>

{% schema %}
{
  "name": "Azaléa Blasen-Seite",
  "settings": [
    { "type": "select", "id": "teil", "label": "Abschnitt", "default": "unten",
      "options": [ { "value": "oben", "label": "Oben (über dem Produkt)" }, { "value": "unten", "label": "Unten (direkt unter dem Produkt)" } ] },
    { "type": "text", "id": "top_text", "label": "Rote Leiste ganz oben", "default": "2+1 GRATIS · Kostenloser Versand" },
    { "type": "text", "id": "kicker", "label": "Überzeile", "default": "Das Blasenpflaster-Kartell" },
    { "type": "text", "id": "headline", "label": "Überschrift", "default": "Gleiches Pflaster. 5× billiger." },
    { "type": "textarea", "id": "subline", "label": "Unterzeile", "default": "Hydrokolloid als Rolle. Selbst zuschneiden – vom kleinen Zeh bis zur ganzen Ferse." },
    { "type": "text", "id": "apotheke_label", "label": "Beschriftung Vergleich", "default": "Apotheke / Drogerie" },
    { "type": "number", "id": "apotheke_cent", "label": "Vergleichspreis pro Pflaster (in Cent)", "default": 184 },
    { "type": "number", "id": "pflaster_pro_rolle", "label": "Pflaster pro Rolle (ca.)", "default": 90 },
    { "type": "number", "id": "stueck_cent", "label": "Euer Preis pro Pflaster (in Cent)", "default": 32 },
    { "type": "image_picker", "id": "bild_1", "label": "Bild Schritt 1 (Zuschneiden)" },
    { "type": "image_picker", "id": "bild_2", "label": "Bild Schritt 2 (Aufkleben)" },
    { "type": "image_picker", "id": "bild_3", "label": "Bild Schritt 3 (Drauflassen)" },
    { "type": "text", "id": "cta", "label": "Text Kauf-Knopf", "default": "Jetzt 2+1 gratis sichern" },
    { "type": "text", "id": "cta_sub", "label": "Unterzeile Kauf-Knopf", "default": "Kostenloser Versand · 30 Tage Geld zurück" },
    { "type": "text", "id": "cta_kurz", "label": "Text Kauf-Knopf (Handy unten)", "default": "2+1 sichern" }
  ],
  "blocks": [
    { "type": "alltag", "name": "Alltag-Foto",
      "settings": [
        { "type": "image_picker", "id": "bild", "label": "Foto" },
        { "type": "text", "id": "titel", "label": "Titel", "default": "Neue Schuhe" },
        { "type": "text", "id": "text", "label": "Text", "default": "Ferse drückt? Groß zuschneiden, fertig." }
      ] }
  ],
  "presets": [ { "name": "Azaléa Blasen-Seite",
    "blocks": [
      { "type": "alltag", "settings": { "titel": "Neue Schuhe", "text": "Ferse drückt? Groß zuschneiden, fertig." } },
      { "type": "alltag", "settings": { "titel": "Wandern", "text": "Hält im Wanderschuh, auch bergab." } },
      { "type": "alltag", "settings": { "titel": "Laufen", "text": "Schmaler Streifen für den kleinen Zeh." } },
      { "type": "alltag", "settings": { "titel": "Büro", "text": "Hautfarben, unter der Strumpfhose kaum zu sehen." } },
      { "type": "alltag", "settings": { "titel": "Festival", "text": "Eine Rolle im Rucksack reicht fürs ganze Wochenende." } },
      { "type": "alltag", "settings": { "titel": "Urlaub", "text": "Wasserfest – auch unter der Dusche im Hotel." } }
    ] } ]
}
{% endschema %}
